# build output
build/
dist/
*.idsig

# the signing key is private and must never be committed
keystore/

# installed tools (package.json and package-lock.json are kept)
tools/.node/node_modules/
tools/.bin/

# local editor and session files
.claude/
*.log

# internal working documents, kept on the maintainer's machine
docs/AUDIT-*.md

# python caches
__pycache__/

# downloaded recordings kept out of the repository (only the clips the films use are kept)
tools/src/adhan-dl/

# Rust build output (windows/)
windows/target/

# Generated Xcode project (rebuilt from ios/project.yml by tools/build_ios.py)
ios/Adhkar.xcodeproj/
ios/*.xcworkspace/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
tools/promo/ramadan-track.mp3
