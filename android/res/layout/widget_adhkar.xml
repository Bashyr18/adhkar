<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg_night" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="68dp" android:layout_height="68dp">
            <ProgressBar android:id="@+id/ring" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="68dp" android:layout_height="68dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_ring" />
            <TextView android:id="@+id/pct" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#FFF5F0E7" android:textSize="16sp" android:textStyle="bold" android:text="0%" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF1D59E" android:textSize="10sp" android:letterSpacing="0.14" android:textStyle="bold" android:maxLines="1" android:text="NOW" />
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF5F0E7" android:textSize="19sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:text="Morning adhkār" />
            <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B3F5F0E7" android:textSize="11.5sp" android:maxLines="2" android:ellipsize="end" android:text="" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><LinearLayout android:id="@+id/k0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="0dp"
            android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_chip">
            <TextView android:id="@+id/kv0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF5F0E7" android:textSize="12sp" android:textStyle="bold" android:text="0%" />
            <TextView android:id="@+id/kl0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99F5F0E7" android:textSize="9.5sp" android:textStyle="bold" android:text="MORNING" /></LinearLayout><LinearLayout android:id="@+id/k1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_chip">
            <TextView android:id="@+id/kv1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF5F0E7" android:textSize="12sp" android:textStyle="bold" android:text="0%" />
            <TextView android:id="@+id/kl1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99F5F0E7" android:textSize="9.5sp" android:textStyle="bold" android:text="EVENING" /></LinearLayout><LinearLayout android:id="@+id/k2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_chip">
            <TextView android:id="@+id/kv2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF5F0E7" android:textSize="12sp" android:textStyle="bold" android:text="0%" />
            <TextView android:id="@+id/kl2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99F5F0E7" android:textSize="9.5sp" android:textStyle="bold" android:text="SLEEP" /></LinearLayout></LinearLayout>
</LinearLayout>
